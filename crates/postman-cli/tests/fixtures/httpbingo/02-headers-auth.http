@host = https://httpbingo.org

### Custom request headers
# @assert status == 200
# @assert jsonpath "$.headers.X-Postman-E2e[0]" == "matrix"
GET {{host}}/headers
X-Postman-E2E: matrix

### Explicit user agent
# @assert status == 200
# @assert jsonpath "$.user-agent" == "postman-cli-matrix"
GET {{host}}/user-agent
User-Agent: postman-cli-matrix

### Basic authentication succeeds
# @assert status == 200
# @assert jsonpath "$.authenticated" == true
# @assert jsonpath "$.user" == "postman"
GET {{host}}/basic-auth/postman/headless
Authorization: Basic cG9zdG1hbjpoZWFkbGVzcw==

### Basic authentication rejects missing credentials
# @assert status == 401
GET {{host}}/basic-auth/postman/headless

### Bearer authentication succeeds
# @assert status == 200
# @assert jsonpath "$.authenticated" == true
# @assert jsonpath "$.token" == "matrix-token"
GET {{host}}/bearer
Authorization: Bearer matrix-token

### Bearer authentication rejects missing credentials
# @assert status == 401
GET {{host}}/bearer

### Hidden basic authentication conceals missing credentials
# @assert status == 404
GET {{host}}/hidden-basic-auth/postman/headless

### Hidden basic authentication succeeds
# @assert status == 200
# @assert jsonpath "$.authenticated" == true
GET {{host}}/hidden-basic-auth/postman/headless
Authorization: Basic cG9zdG1hbjpoZWFkbGVzcw==

