@host = https://httpbingo.org

### Gzip decoding
# @assert status == 200
# @assert jsonpath "$.gzipped" == true
GET {{host}}/gzip

### Deflate decoding
# @assert status == 200
# @assert jsonpath "$.deflated" == true
GET {{host}}/deflate

### Zero-delay response
# @assert status == 200
GET {{host}}/delay/0

### Per-request deadline
# @timeout-ms 100
# @assert error == timeout
GET {{host}}/delay/2

### Buffered drip response
# @assert status == 201
# @assert body contains "*****"
GET {{host}}/drip?duration=0.1&numbytes=5&code=201&delay=0

### Deterministic unstable endpoint success path
# @assert status == 200
GET {{host}}/unstable?failure_rate=0&seed=171

### Finite newline-delimited stream (buffered)
# @assert status == 200
# @assert header "content-type" contains "text/plain"
# @assert body contains "id"
GET {{host}}/stream/2

### Finite JSON Lines response (buffered)
# @assert status == 200
# @assert header "content-type" contains "application/x-ndjson"
# @assert body contains "id"
GET {{host}}/jsonl

### Finite server-sent event response (buffered)
# @assert status == 200
# @assert header "content-type" contains "text/event-stream"
# @assert body contains "data:"
GET {{host}}/sse?count=2&duration=0.1&delay=0
