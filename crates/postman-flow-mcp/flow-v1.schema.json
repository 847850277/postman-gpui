{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/847850277/postman-gpui/schemas/postman-flow-v1.json",
  "title": "postman-flow document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "flow"],
  "properties": {
    "schema_version": { "const": 1 },
    "flow": { "$ref": "#/$defs/flow" },
    "apis": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/api" }
    },
    "editor": { "$ref": "#/$defs/editor" }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/input" },
          "default": []
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/output" },
          "default": []
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "default": true,
        "sensitive": { "type": "boolean", "default": false }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/http_step" },
        { "$ref": "#/$defs/for_each_step" },
        { "$ref": "#/$defs/repeat_until_step" }
      ]
    },
    "http_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "name": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "request": { "$ref": "#/$defs/request" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" },
          "default": []
        },
        "exports": {
          "type": "array",
          "items": { "$ref": "#/$defs/export" },
          "default": []
        }
      }
    },
    "for_each_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items", "as", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "name": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "kind": { "const": "for_each" },
        "items": { "$ref": "#/$defs/json_expression" },
        "as": { "$ref": "#/$defs/name" },
        "index_as": { "$ref": "#/$defs/name" },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 100
        },
        "on_error": {
          "enum": ["fail_fast", "continue"],
          "default": "fail_fast"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "exports": {
          "type": "array",
          "items": { "$ref": "#/$defs/collection_export" },
          "default": []
        }
      }
    },
    "repeat_until_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "until", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "name": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "kind": { "const": "repeat_until" },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 20
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 1000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "default": 60000
        },
        "until": { "$ref": "#/$defs/condition" },
        "fail_when": { "$ref": "#/$defs/condition" },
        "carry": {
          "type": "array",
          "items": { "$ref": "#/$defs/carry" },
          "default": []
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "collection_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "collect"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "collect": { "$ref": "#/$defs/step_ref" }
      }
    },
    "carry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initial", "from"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "initial": { "$ref": "#/$defs/json_expression" },
        "from": { "$ref": "#/$defs/step_ref" }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "method", "url"],
          "properties": {
            "kind": { "const": "http" },
            "method": {
              "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
            },
            "url": { "$ref": "#/$defs/text" },
            "headers": {
              "type": "array",
              "items": { "$ref": "#/$defs/header" },
              "default": []
            },
            "body": { "$ref": "#/$defs/body" },
            "options": { "$ref": "#/$defs/options" },
            "auth": { "$ref": "#/$defs/auth" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "api"],
          "properties": {
            "kind": { "const": "api" },
            "api": { "$ref": "#/$defs/name" },
            "bindings": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/text" },
              "default": {}
            }
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/name" },
          "default": []
        },
        "request": { "$ref": "#/$defs/api_request" }
      }
    },
    "api_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": {
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
        },
        "url": { "$ref": "#/$defs/text" },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/header" },
          "default": []
        },
        "body": { "$ref": "#/$defs/body" },
        "options": { "$ref": "#/$defs/options" },
        "auth": { "$ref": "#/$defs/auth" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/text" }
      }
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "json" },
            "value": { "$ref": "#/$defs/json_expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["json_template", "raw", "url_encoded", "file"] },
            "value": { "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "redirect_policy": { "enum": ["follow", "do_not_follow"] },
        "max_redirect_hops": { "type": "integer", "minimum": 0 }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secret"],
      "properties": {
        "type": { "const": "hmac_sha256" },
        "secret": { "$ref": "#/$defs/text" },
        "param": { "type": "string", "default": "signature" }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": { "input": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["output"],
          "properties": { "output": { "$ref": "#/$defs/step_ref" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["concat"],
          "properties": {
            "concat": { "type": "array", "items": { "$ref": "#/$defs/text" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["coalesce"],
          "properties": {
            "coalesce": { "type": "array", "items": { "$ref": "#/$defs/text" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["calc"],
          "properties": { "calc": { "type": "string" } }
        }
      ]
    },
    "json_expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["string"],
          "properties": { "string": { "$ref": "#/$defs/text" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": { "input": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["output"],
          "properties": { "output": { "$ref": "#/$defs/step_ref" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["object"],
          "properties": {
            "object": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/json_expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["array"],
          "properties": {
            "array": { "type": "array", "items": { "$ref": "#/$defs/json_expression" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["coalesce"],
          "properties": {
            "coalesce": { "type": "array", "items": { "$ref": "#/$defs/json_expression" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["calc"],
          "properties": { "calc": { "type": "string" } }
        }
      ]
    },
    "step_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "name"],
      "properties": {
        "step": { "$ref": "#/$defs/name" },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/binary_condition" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["and"],
          "properties": {
            "and": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["or"],
          "properties": {
            "or": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "binary_condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in"] },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "$ref": "#/$defs/json_expression" }
      }
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equals"],
          "properties": {
            "kind": { "const": "status" },
            "equals": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "equals"],
          "properties": {
            "kind": { "const": "jsonpath" },
            "path": { "type": "string" },
            "equals": { "$ref": "#/$defs/json_expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "header_exists" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "equals"],
          "properties": {
            "kind": { "const": "header_contains" },
            "name": { "type": "string" },
            "equals": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equals"],
          "properties": {
            "kind": { "const": "body_contains" },
            "equals": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equals"],
          "properties": {
            "kind": { "const": "redirects" },
            "equals": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equals"],
          "properties": {
            "kind": { "const": "error" },
            "equals": {
              "enum": [
                "timeout",
                "redirect-limit",
                "network",
                "invalid-request",
                "invalid-response",
                "response-too-large",
                "cancelled"
              ]
            }
          }
        }
      ]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "path": { "type": "string" },
        "sensitive": { "type": "boolean", "default": false }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "value": { "$ref": "#/$defs/value_reference" }
      }
    },
    "value_reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": { "input": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["output"],
          "properties": { "output": { "$ref": "#/$defs/step_ref" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["coalesce"],
          "properties": {
            "coalesce": { "type": "array", "items": { "$ref": "#/$defs/value_reference" } }
          }
        }
      ]
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
