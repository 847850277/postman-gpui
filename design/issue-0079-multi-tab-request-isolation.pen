                      "fill": "$text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Two independent RequestViewModels; tab switching and close projection; tab-local response and dirty state; immutable tab_id async targeting; runtime History projection plus application-service durability handoff; mouse and keyboard parity.",
                      "lineHeight": 1.3,
                      "fontFamily": "$fontBody",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "r81qvM",
