                      "letterSpacing": 0.6
                    },
                    {
                      "type": "text",
                      "id": "XVjeb",
                      "name": "Non-Goals Content",
                      "fill": "$text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "No tab drag/reorder, pinning, reopening closed tabs, tab persistence, cross-window synchronization, or automatic replay. #127 persists sanitized History only; active tab, pane, response, and dirty state remain runtime-only. Closing the final tab and unsaved-draft confirmation remain outside #79.",
                      "lineHeight": 1.3,
                      "fontFamily": "$fontBody",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    },
