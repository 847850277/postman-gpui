                      "fill": "$accent",
                      "content": "SCOPE · BOUNDARIES · OWNER",
                      "fontFamily": "$fontBody",
                      "fontSize": 9,
                      "fontWeight": "850"
                    },
                    {
                      "type": "text",
                      "id": "dAoic",
                      "name": "Included Scope",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "INCLUDED\n/bytes, /range, /stream, /drip · byte-native payload · Receiving / Success / Cancelled · bounded preview · Save as · atomic commit · partial cleanup · History metadata consistency.",
                      "lineHeight": 1.55,
                      "fontFamily": "$fontBody",
                      "fontSize": 8,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "IkcIz",
                      "name": "Explicit Non-Goals",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "NON-GOALS / OUT OF SCOPE\nPersisting response bytes, canonical spools, or download destinations; download manager, resume / retry, parallel segments, media viewers, huge-body benchmarks, and OS-specific picker styling.",
                      "lineHeight": 1.55,
                      "fontFamily": "$fontBody",
                      "fontSize": 8,
                      "fontWeight": "700"
                    },
