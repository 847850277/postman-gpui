{
  "schema_version": 2,
  "cases": [
    {
      "name": "GET encodes new query parameters and keeps the existing query",
      "draft": {
        "method": "GET",
        "path": "/search?existing=1",
        "params": [
          { "key": "q", "value": "rust gpui" },
          { "key": "locale", "value": "中文" }
        ]
      },
      "mock": {
        "status": 200,
        "headers": [["content-type", "application/json"]],
        "body": "{\"items\":[]}"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/search?existing=1&q=rust+gpui&locale=%E4%B8%AD%E6%96%87",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_contains": "items",
          "headers_contain": [["content-type", "application/json"]]
        },
        "history_len": 1
      }
    },
    {
      "name": "POST sends JSON defaults, a custom header, and normalized Bearer auth",
      "draft": {
        "method": "POST",
        "path": "/users",
        "headers": [
          { "key": "X-Trace", "value": "scenario-42" }
        ],
        "body": "{\"name\":\"Ada\"}",
        "body_kind": "json",
        "bearer_token": "Bearer scenario-token"
      },
      "mock": {
        "status": 201,
        "body": "{\"id\":42}"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/users",
          "headers": [
            ["Content-Type", "application/json"],
            ["Accept", "application/json"],
            ["X-Trace", "scenario-42"],
            ["Authorization", "Bearer scenario-token"]
          ],
          "body": "{\"name\":\"Ada\"}"
        },
        "response": {
          "kind": "success",
          "status": 201,
          "body_contains": "42"
        },
        "history_len": 1
      }
    },
    {
      "name": "disabled query parameters and headers are omitted",
      "draft": {
        "method": "GET",
        "path": "/items",
        "params": [
          { "key": "visible", "value": "yes" },
          { "key": "secret", "value": "no", "enabled": false }
        ],
        "headers": [
          { "key": "X-Enabled", "value": "yes" },
          { "key": "X-Disabled", "value": "no", "enabled": false }
        ]
      },
      "mock": {
        "status": 204
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/items?visible=yes",
          "headers": [["X-Enabled", "yes"]],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 204
        },
        "history_len": 1
      }
    },
    {
      "name": "PUT sends JSON content type when JSON is already the selected body kind",
      "draft": {
        "method": "PUT",
        "path": "/documents/42",
        "body": "{\"title\":\"Scenario contract\"}",
        "body_kind": "json"
      },
      "mock": {
        "status": 200,
        "body": "updated"
      },
      "expect": {
        "request": {
          "method": "PUT",
          "path": "/documents/42",
          "headers": [["Content-Type", "application/json"]],
          "body": "{\"title\":\"Scenario contract\"}"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_contains": "updated"
        },
        "history_len": 1
      }
    },
    {
      "name": "form data adds its content type when the user did not provide one",
      "draft": {
        "method": "PUT",
        "path": "/profile",
        "body": "name=Ada+Lovelace&active=true",
        "body_kind": "form_data"
      },
      "mock": {
        "status": 200,
        "body": "saved"
      },
      "expect": {
        "request": {
          "method": "PUT",
          "path": "/profile",
          "headers": [["Content-Type", "application/x-www-form-urlencoded"]],
          "body": "name=Ada+Lovelace&active=true"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_contains": "saved"
        },
        "history_len": 1
      }
    },
    {
      "name": "POST form data replaces the default JSON content type",
      "draft": {
        "method": "POST",
        "path": "/submit",
        "body": "name=Ada&active=true",
        "body_kind": "form_data"
      },
      "mock": {
        "status": 200,
        "body": "ok"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/submit",
          "headers": [
            ["Content-Type", "application/x-www-form-urlencoded"],
            ["Accept", "application/json"]
          ],
          "body": "name=Ada&active=true"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_contains": "ok"
        },
        "history_len": 1
      }
    },
    {
      "name": "raw body removes an automatically generated content type",
      "draft": {
        "method": "POST",
        "path": "/raw",
        "body": "plain text",
        "body_kind": "raw"
      },
      "mock": {
        "status": 200,
        "body": "ok"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/raw",
          "headers": [["Accept", "application/json"]],
          "body": "plain text"
        },
        "response": {
          "kind": "success",
          "status": 200
        },
        "history_len": 1
      }
    },
    {
      "name": "manual content type wins over automatic body kind defaults",
      "draft": {
        "method": "POST",
        "path": "/custom",
        "headers": [
          { "key": "content-type", "value": "application/vnd.example+json" }
        ],
        "body": "custom payload",
        "body_kind": "raw"
      },
      "mock": {
        "status": 202,
        "body": "accepted"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/custom",
          "headers": [
            ["Content-Type", "application/vnd.example+json"],
            ["Accept", "application/json"]
          ],
          "body": "custom payload"
        },
        "response": {
          "kind": "success",
          "status": 202,
          "body_contains": "accepted"
        },
        "history_len": 1
      }
    },
    {
      "name": "methods without request bodies do not send the body buffer",
      "draft": {
        "method": "DELETE",
        "path": "/users/42",
        "body": "this must not be sent",
        "body_kind": "raw"
      },
      "mock": {
        "status": 204
      },
      "expect": {
        "request": {
          "method": "DELETE",
          "path": "/users/42",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 204
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTP 404 is a completed response and enters history",
      "draft": {
        "method": "GET",
        "path": "/missing"
      },
      "mock": {
        "status": 404,
        "headers": [["content-type", "application/json"]],
        "body": "{\"error\":\"missing\"}"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/missing",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 404,
          "body_contains": "missing",
          "headers_contain": [["content-type", "application/json"]]
        },
        "history_len": 1
      }
    },
    {
      "name": "failed sends expose an error and never enter shared history",
      "draft": {
        "method": "GET",
        "path": ""
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "error",
          "contains": "URL cannot be empty"
        },
        "history_len": 0
      }
    }
  ]
}
