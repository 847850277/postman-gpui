{
  "schema_version": 5,
  "target": "httpbingo",
  "cases": [
    {
      "name": "HTTPBingo receives a POST JSON body and generated headers",
      "draft": {
        "method": "POST",
        "path": "/anything/post-json",
        "headers": [
          { "key": "X-Scenario", "value": "httpbingo-json" }
        ],
        "body": "{\"name\":\"Ada\",\"active\":true}",
        "body_kind": "json"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/anything/post-json",
          "headers": [
            ["Content-Type", "application/json"],
            ["Accept", "application/json"],
            ["X-Scenario", "httpbingo-json"]
          ],
          "body": "{\"name\":\"Ada\",\"active\":true}"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "POST",
            "headers": {
              "Content-Type": ["application/json"],
              "X-Scenario": ["httpbingo-json"]
            },
            "data": "{\"name\":\"Ada\",\"active\":true}",
            "json": {
              "name": "Ada",
              "active": true
            }
          }
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo preserves multiple URL-encoded rows and omits drafts",
      "draft": {
        "method": "POST",
        "path": "/anything/form",
        "body": "name=Ada+Lovelace&active=true&tag=rust&tag=gpui",
        "body_kind": "url_encoded",
        "precreate_body_rows": 9,
        "body_rows": [
          { "key": "name", "value": "Ada Lovelace" },
          { "key": "active", "value": "true" },
          { "key": "tag", "value": "rust" },
          { "key": "ignored", "value": "not-sent", "enabled": false },
          { "key": "", "value": "draft-only" },
          { "key": "tag", "value": "gpui" }
        ]
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/anything/form",
          "headers": [
            ["Content-Type", "application/x-www-form-urlencoded"],
            ["Accept", "application/json"]
          ],
          "body": "name=Ada+Lovelace&active=true&tag=rust&tag=gpui"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "POST",
            "headers": {
              "Content-Type": ["application/x-www-form-urlencoded"]
            },
            "form": {
              "name": ["Ada Lovelace"],
              "active": ["true"],
              "tag": ["rust", "gpui"]
            }
          }
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo receives the HTML form submission at POST /post",
      "draft": {
        "method": "POST",
        "path": "/post",
        "body": "custname=Ada+Lovelace&custtel=%2B86+123456&custemail=ada%40example.com&size=large&topping=bacon&topping=cheese&delivery=18%3A30&comments=Ring+the+bell",
        "body_kind": "url_encoded"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/post",
          "headers": [
            ["Content-Type", "application/x-www-form-urlencoded"],
            ["Accept", "application/json"]
          ],
          "body": "custname=Ada+Lovelace&custtel=%2B86+123456&custemail=ada%40example.com&size=large&topping=bacon&topping=cheese&delivery=18%3A30&comments=Ring+the+bell"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "POST",
            "url": "https://httpbingo.org/post",
            "headers": {
              "Content-Type": ["application/x-www-form-urlencoded"]
            },
            "form": {
              "custname": ["Ada Lovelace"],
              "custtel": ["+86 123456"],
              "custemail": ["ada@example.com"],
              "size": ["large"],
              "topping": ["bacon", "cheese"],
              "delivery": ["18:30"],
              "comments": ["Ring the bell"]
            }
          }
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo receives a raw PUT body without generated content type",
      "draft": {
        "method": "PUT",
        "path": "/anything/raw",
        "body": "plain text body",
        "body_kind": "raw"
      },
      "expect": {
        "request": {
          "method": "PUT",
          "path": "/anything/raw",
          "headers": [],
          "body": "plain text body"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "PUT",
            "data": "data:application/octet-stream;base64,cGxhaW4gdGV4dCBib2R5"
          }
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo receives a PATCH JSON body",
      "draft": {
        "method": "PATCH",
        "path": "/patch",
        "body": "{\"patched\":true}",
        "body_kind": "json"
      },
      "expect": {
        "request": {
          "method": "PATCH",
          "path": "/patch",
          "headers": [["Content-Type", "application/json"]],
          "body": "{\"patched\":true}"
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "PATCH",
            "json": {
              "patched": true
            }
          }
        },
        "history_len": 1
      }
    }
  ]
}
