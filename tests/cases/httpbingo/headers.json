{
  "schema_version": 3,
  "target": "httpbingo",
  "cases": [
    {
      "name": "HTTPBingo receives enabled values from multiple independently editable Header rows",
      "draft": {
        "method": "GET",
        "path": "/headers",
        "precreate_header_rows": 5,
        "headers": [
          { "key": "X-Scenario", "value": "multiple-header-rows" },
          { "key": "X-Locale", "value": "zh-CN" },
          { "key": "X-Disabled", "value": "must-not-be-sent", "enabled": false }
        ]
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/headers",
          "headers": [
            ["X-Scenario", "multiple-header-rows"],
            ["X-Locale", "zh-CN"]
          ],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "headers": {
              "X-Scenario": ["multiple-header-rows"],
              "X-Locale": ["zh-CN"]
            }
          }
        },
        "history_len": 1
      }
    }
  ]
}
