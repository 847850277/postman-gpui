{
  "schema_version": 5,
  "target": "httpbingo",
  "cases": [
    {
      "name": "HTTPBingo serves the HTML form that submits to POST /post",
      "draft": {
        "method": "GET",
        "path": "/forms/post"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/forms/post",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_contains": "<form method=\"post\" action=\"/post\">"
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo non-2xx status is still a completed response",
      "draft": {
        "method": "GET",
        "path": "/status/418"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/status/418",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 418,
          "body_contains": "I'm a teapot!"
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo redirect is followed to the final response",
      "draft": {
        "method": "GET",
        "path": "/redirect-to?url=%2Fanything%2Fredirected&status_code=302"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/redirect-to?url=%2Fanything%2Fredirected&status_code=302",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "method": "GET",
            "url": "https://httpbingo.org/anything/redirected"
          }
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo response headers are inspectable by mouse and keyboard",
      "draft": {
        "method": "GET",
        "path": "/response-headers?X-E2E-Header=visible&Content-Type=application/json"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/response-headers?X-E2E-Header=visible&Content-Type=application/json",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "headers_contain": [
            ["X-E2E-Header", "visible"],
            ["Content-Type", "application/json"]
          ]
        },
        "history_len": 1
      }
    },
    {
      "name": "HTTPBingo JSON response is parsed with stable subset assertions",
      "draft": {
        "method": "GET",
        "path": "/json"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/json",
          "headers": [],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "slideshow": {
              "title": "Sample Slide Show"
            }
          }
        },
        "history_len": 1
      }
    }
  ]
}
