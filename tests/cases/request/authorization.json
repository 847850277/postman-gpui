{
  "schema_version": 3,
  "target": "local",
  "cases": [
    {
      "name": "POST sends JSON defaults, a custom header, and normalized Bearer auth",
      "draft": {
        "method": "POST",
        "path": "/users",
        "headers": [
          { "key": "X-Trace", "value": "scenario-42" }
        ],
        "body": "{\"name\":\"Ada\"}",
        "body_kind": "json",
        "bearer_token": "Bearer scenario-token"
      },
      "mock": {
        "status": 201,
        "body": "{\"id\":42}"
      },
      "expect": {
        "request": {
          "method": "POST",
          "path": "/users",
          "headers": [
            ["Content-Type", "application/json"],
            ["Accept", "application/json"],
            ["X-Trace", "scenario-42"],
            ["Authorization", "Bearer scenario-token"]
          ],
          "body": "{\"name\":\"Ada\"}"
        },
        "response": {
          "kind": "success",
          "status": 201,
          "body_contains": "42"
        },
        "history_len": 1
      }
    },
    {
      "name": "GET sends Basic authentication credentials",
      "draft": {
        "method": "GET",
        "path": "/basic-auth",
        "basic_auth": {
          "username": "local-user",
          "password": "local-pass"
        }
      },
      "mock": {
        "status": 200,
        "body": "{\"authenticated\":true}"
      },
      "expect": {
        "request": {
          "method": "GET",
          "path": "/basic-auth",
          "headers": [["Authorization", "Basic bG9jYWwtdXNlcjpsb2NhbC1wYXNz"]],
          "body": null
        },
        "response": {
          "kind": "success",
          "status": 200,
          "body_json_contains": {
            "authenticated": true
          }
        },
        "history_len": 1
      }
    }
  ]
}
